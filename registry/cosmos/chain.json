{
  "$schema": "https://raw.githubusercontent.com/cosmos/chain-registry/master/chain.schema.json",
  "chain_name": "sobya",
  "chain_type": "cosmos",
  "chain_id": "sobya-1",
  "website": "https://github.com/snforem-cpu/sobya-chain",
  "pretty_name": "SOBYA",
  "status": "live",
  "network_type": "mainnet",
  "bech32_prefix": "sobya",
  "daemon_name": "sobyad",
  "node_home": "$HOME/.sobya",
  "key_algos": ["secp256k1"],
  "slip44": 118,
  "staking": {
    "staking_tokens": [
      { "denom": "asobya" }
    ]
  },
  "logo_URIs": {
    "png": "https://raw.githubusercontent.com/snforem-cpu/sobya-chain/main/assets/logo/sobya-coin-128.png"
  },
  "description": "SOBYA is a Cosmos SDK and CometBFT blockchain with Cosmos EVM compatibility. Its native asset SOBY uses 18 decimal places.",
  "apis": {
    "rpc": [
      {
        "address": "https://sobya-rpc.nodesafe-app.xyz",
        "provider": "NodeSafe"
      }
    ],
    "rest": [
      {
        "address": "https://sobya-api.nodesafe-app.xyz",
        "provider": "NodeSafe"
      }
    ]
  },
  "evm": {
    "chain_id": "357812033857",
    "rpc": [
      {
        "address": "https://sobya-evm-rpc.nodesafe-app.xyz",
        "provider": "NodeSafe"
      }
    ]
  },
  "explorers": [
    {
      "kind": "other",
      "url": "https://explorer.nodesafe-app.xyz/sobya",
      "tx_page": "https://explorer.nodesafe-app.xyz/sobya/txs/${txHash}",
      "account_page": "https://explorer.nodesafe-app.xyz/sobya/accounts/${accountAddress}"
    }
  ]
}
