  },
  "apis": {
    "rpc": [{ "address": "https://sobya-rpc.nodesafe-app.xyz", "provider": "NodeSafe" }],
    "rest": [{ "address": "https://sobya-api.nodesafe-app.xyz", "provider": "NodeSafe" }],
    "evm-http-jsonrpc": [{ "address": "https://sobya-evm-rpc.nodesafe-app.xyz", "provider": "NodeSafe" }]
  },
